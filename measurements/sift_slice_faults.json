{
  "measurement": "faults",
  "dataset": "sift_slice/sift_base_slice.fvecs",
  "config": {
    "d": 128,
    "m": 16,
    "b": 8,
    "n": 3000,
    "r": 100,
    "k": 10,
    "seed": 42
